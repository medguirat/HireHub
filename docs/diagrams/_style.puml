skinparam UsecaseBackgroundColor #EEF2FA
skinparam RectangleBorderColor #132B64
skinparam PackageBorderColor #132B64
skinparam ClassBorderColor #132B64
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #EEF2FA
skinparam NoteBorderColor #E81B6B
skinparam NoteBackgroundColor #FFF4F8
skinparam ParticipantBorderColor #132B64
skinparam ParticipantBackgroundColor #EEF2FA
skinparam DatabaseBorderColor #132B64
skinparam DatabaseBackgroundColor #EEF2FA
skinparam NodeBorderColor #132B64
skinparam NodeBackgroundColor #FFFFFF
skinparam ComponentBorderColor #132B64
skinparam ComponentBackgroundColor #EEF2FA
skinparam SequenceLifeLineBorderColor #8C8E90
skinparam SequenceGroupBorderColor #8C8E90
skinparam SequenceBoxBorderColor #8C8E90
