# HireHub local configuration. Copy this file to .env (never commit .env) and fill it in.
# `npm run dev` creates .env from this file on first run, with a generated JWT_SECRET.
# Format: KEY=VALUE, no quotes. Variables already set in your environment take precedence.

# --- Database (MySQL) -------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/hirehub_db?createDatabaseIfNotExist=true
DB_USERNAME=root
# Your MySQL password (leave empty after = if the account has none).
DB_PASSWORD=

# --- Login tokens -----------------------------------------------------------
# Base64 key of at least 32 bytes (256 bits). Generate one with: npm run secret
# The backend refuses to start without a valid one. Changing it logs everyone out.
JWT_SECRET=

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# --- Optional: local LLM for rewording (see README, "Optional: a local AI model with Ollama")
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=
