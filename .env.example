# HireHub local configuration. Copy this file to .env (never commit .env) and fill it in.
# `npm run dev` creates .env from this file on first run, with a generated JWT_SECRET.
# Format: KEY=VALUE, no quotes. Variables already set in your environment take precedence.

# --- Database (MySQL) -------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/hirehub_db?createDatabaseIfNotExist=true
DB_USERNAME=root
# Your MySQL password (leave empty after = if the account has none).
DB_PASSWORD=

# --- Login tokens -----------------------------------------------------------
# Base64 key of at least 32 bytes (256 bits). Generate one with: npm run secret
# The backend refuses to start without a valid one. Changing it logs everyone out.
JWT_SECRET=

# --- ai-service ----------------------------------------------------------
# Shared by the backend and the ai-service, which answers nobody else: at least 32 random
# characters. `npm run dev` generates one (and adds it to an older .env that lacks it).
AI_SERVICE_KEY=

# --- Email -----------------------------------------------------------------
# MAIL_MODE=mailpit (default): emails go to Mailpit, the local test inbox `npm run dev` starts.
#   Nothing leaves your machine; read them at http://localhost:8025.
# MAIL_MODE=smtp: emails really go to people's mailboxes, through the server below.
#   Gmail (free): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=your Gmail address,
#   SMTP_PASSWORD=a Gmail *app password* (16 letters, not your Google password). Step by step in
#   the README, "Emails". The automated tests always use Mailpit, whatever is set here.
MAIL_MODE=mailpit
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender shown to recipients. Leave empty to use "HireHub <SMTP_USERNAME>" (Gmail requires your own address).
MAIL_FROM=
# Where links in emails (e.g. "reset your password") point.
APP_FRONTEND_URL=http://localhost:5173

# --- Optional: open the app from a phone on the same Wi-Fi (README "Open the app from a phone") ---
# DEV_LAN_ACCESS=true
# APP_FRONTEND_URL=http://192.168.1.8:5173     (this computer's address on the Wi-Fi)
# APP_BASE_URL=http://192.168.1.8:5173         (so photos and logos load on the phone too)

# --- Optional: local LLM for rewording (see README, "Optional: a local AI model with Ollama")
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=

# --- Docker (docker compose up) ----------------------------------------------
# Password of the "hirehub" MySQL user inside Docker (its own database, not your local MySQL).
DOCKER_DB_PASSWORD=
# Port of the app on this computer. Change it if 8080 is taken (e.g. by Oracle Database XE).
# FRONTEND_PORT=8080
# The address users open the app at (links in emails, image addresses).
# Default http://localhost:<FRONTEND_PORT>
# DOCKER_PUBLIC_URL=http://localhost:8080
# Swagger UI on http://localhost:8081/swagger-ui.html in Docker
# API_DOCS_ENABLED=true
